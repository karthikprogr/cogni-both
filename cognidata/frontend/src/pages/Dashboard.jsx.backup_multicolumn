// ═══════════════════════════════════════════════════════════════════════════════
// OVERVIEW TAB - Memoized with cached API calls
// ═══════════════════════════════════════════════════════════════════════════════
const OverviewTab = memo(function OverviewTab() {
  const [palette, setPalette] = useState("Indigo");
  const [chartsLoading, setChartsLoading] = useState(false);
  const [charts, setCharts] = useState([]);

  const PALETTES = useMemo(() => ["Indigo", "Emerald", "Sunset", "Ocean"], []);

  // Cache data/info with automatic caching
  const { data: info, loading: infoLoading } = useApiCache(
    "data-info",
    useCallback(async () => {
      const res = await api.get("/data/info");
      const d = res.data;
      if (d && typeof d.rows === "number") return d;
      return null;
    }, []),
    []
  );

  // Load charts with palette dependency
  const loadCharts = useCallback(async (pal) => {
    setChartsLoading(true);
    try {
      const res = await api.get(`/viz/overview?max_charts=4&palette=${pal}`);
      setCharts(res.data?.charts || []);
    } catch (error) {
      console.error("Charts load error:", error);
      setCharts([]);
    } finally {
      setChartsLoading(false);
    }
  }, []);

  useEffect(() => {
    loadCharts(palette);
  }, [palette, loadCharts]);

  const handlePaletteChange = useCallback((p) => {
    setPalette(p);
  }, []);

  // Memoize KPI calculations
  const kpiData = useMemo(() => {
    if (!info) return null;
    
    const missingRaw = info.missing_values;
    const missing = typeof missingRaw === "number"
      ? missingRaw
      : (missingRaw && typeof missingRaw === "object")
        ? Object.values(missingRaw).reduce((a, b) => a + (Number(b) || 0), 0)
        : 0;

    return [
      ["Rows", info.rows?.toLocaleString(), "#6366f1"],
      ["Columns", info.columns, "#10b981"],
      ["Numeric", Array.isArray(info.numeric_columns) ? info.numeric_columns.length : (info.numeric_columns || 0), "#f59e0b"],
      ["Categorical", Array.isArray(info.categorical_columns) ? info.categorical_columns.length : (info.categorical_columns || 0), "#0ea5e9"],
      ["Missing", missing, missing > 0 ? "#ef4444" : "#22c55e"],
    ];
  }, [info]);

  if (!info && !infoLoading) return (
    <div style={S.empty}>
      <div style={{ fontSize: 40, marginBottom: 12 }}>📤</div>
      <div style={{ fontWeight: 600, color: "#a1a1aa" }}>No dataset loaded</div>
      <div style={{ fontSize: 12, marginTop: 6 }}>Upload a CSV, Excel, or JSON file to see your dashboard</div>
    </div>
  );

  return (
    <div>
      {/* Palette Selector */}
      <div style={{ display: "flex", gap: 8, marginBottom: 16, alignItems: "center" }}>
        <span style={{ fontSize: 12, color: "#71717a" }}>Palette:</span>
        {PALETTES.map(p => (
          <button key={p} onClick={() => handlePaletteChange(p)}
            style={{ padding: "4px 12px", borderRadius: 20, border: "1px solid", fontSize: 11, cursor: "pointer",
              background: palette === p ? "rgba(99,102,241,.2)" : "transparent",
              borderColor: palette === p ? "rgba(99,102,241,.5)" : "rgba(255,255,255,.1)",
              color: palette === p ? "#818cf8" : "#71717a",
              transition: "all .2s" }}>
            {p}
          </button>
        ))}
        {chartsLoading && <span style={{ fontSize: 11, color: "#52525b" }}>Loading…</span>}
      </div>

      {/* KPI Cards */}
      {infoLoading ? (
        <div style={S.kpiGrid}>
          {Array.from({ length: 5 }).map((_, i) => <SkeletonKPI key={i} />)}
        </div>
      ) : kpiData && (
        <div style={S.kpiGrid}>
          {kpiData.map(([label, val, color]) => (
            <div key={label} style={S.kpi}>
              <div style={{ ...S.kpiVal, color }}>{typeof val === "object" ? "—" : (val ?? "—")}</div>
              <div style={S.kpiLbl}>{label}</div>
            </div>
          ))}
        </div>
      )}

      {/* Charts Grid */}
      {chartsLoading ? (
        <div style={S.grid2}>
          {Array.from({ length: 6 }).map((_, i) => (
            <div key={i} style={S.chartCard}>
              <div style={S.chartTitle}>Loading...</div>
              <SkeletonChart height={260} />
            </div>
          ))}
        </div>
      ) : charts.length > 0 ? (
        <div style={S.grid2}>
          {charts.map((c, i) => (
            <div key={i} style={S.chartCard}>
              <div style={S.chartTitle}>{c.title}</div>
              <Safe>
                <Chart figure={c.plotly_json} height={260} />
              </Safe>
            </div>
          ))}
        </div>
      ) : !infoLoading && info && (
        <div style={{ ...S.card, textAlign: "center", color: "#52525b", padding: 30 }}>
          Charts are loading… if they don't appear, check your API key in Settings.
        </div>
      )}
    </div>
  );
});

// ═══════════════════════════════════════════════════════════════════════════════
// DATA EXPLORER TAB - Memoized with cached data and optimized pagination
// ═══════════════════════════════════════════════════════════════════════════════
const ExplorerTab = memo(function ExplorerTab() {
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(0);
  const PAGE_SIZE = 20;

  // Cached preview data
  const { data: preview, loading: previewLoading } = useApiCache(
    "data-preview",
    useCallback(async () => {
      const res = await api.get("/data/preview?n=500");
      return res.data;
    }, []),
    []
  );

  // Cached stats data
  const { data: stats } = useApiCache(
    "data-stats",
    useCallback(async () => {
      const res = await api.get("/data/stats");
      return res.data;
    }, []),
    []
  );

  const handleSearchChange = useCallback((e) => {
    setSearch(e.target.value);
    setPage(0);
  }, []);

  const handlePrevPage = useCallback(() => {
    setPage(p => Math.max(0, p - 1));
  }, []);

  const handleNextPage = useCallback((totalPages) => {
    setPage(p => Math.min(totalPages - 1, p + 1));
  }, []);

  // Memoize filtered and paged data
  const { rows, cols, filtered, paged, totalPages } = useMemo(() => {
    if (!preview) return { rows: [], cols: [], filtered: [], paged: [], totalPages: 0 };
    
    const rows = preview.data || [];
    const cols = preview.columns || [];
    
    // Debug logging
    console.log("Data Explorer Debug:", { 
      previewExists: !!preview, 
      rowsCount: rows.length, 
      colsCount: cols.length,
      page: page,
      PAGE_SIZE: PAGE_SIZE
    });
    
    const filtered = search
      ? rows.filter(r => Object.values(r).some(v => String(v).toLowerCase().includes(search.toLowerCase())))
      : rows;
    
    const paged = filtered.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE);
    const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
    
    return { rows, cols, filtered, paged, totalPages };
  }, [preview, search, page, PAGE_SIZE]);

  if (previewLoading) {
    return (
      <div>
        <div style={{ marginBottom: 12 }}>
          <SkeletonBox height="40px" />
        </div>
        <div style={{ ...S.card, padding: 16 }}>
          <SkeletonTable rows={10} cols={5} />
        </div>
      </div>
    );
  }

  if (!preview) return <div style={S.empty}>No dataset loaded</div>;

  return (
    <div>
      {/* Stats */}
      {stats && (
        <div style={{ display: "flex", gap: 10, marginBottom: 16, flexWrap: "wrap" }}>
          {Object.entries(stats).slice(0, 6).map(([col, s]) => (
            <div key={col} style={{ ...S.kpi, flex: "1 1 130px" }}>
              <div style={{ fontSize: 11, color: "#71717a", marginBottom: 4, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{col}</div>
              <div style={{ fontSize: 13, color: "#e4e4e7" }}>μ {typeof s.mean === "number" ? s.mean.toFixed(2) : "—"}</div>
              <div style={{ fontSize: 11, color: "#52525b" }}>σ {typeof s.std === "number" ? s.std.toFixed(2) : "—"}</div>
            </div>
          ))}
        </div>
      )}

      <div style={{ marginBottom: 12 }}>
        <input style={S.input} placeholder="Search rows…" value={search}
          onChange={handleSearchChange} />
      </div>

      <div style={{ ...S.card, padding: 0, overflowX: "auto" }}>
        {paged.length === 0 && <div style={{ padding: 20, textAlign: "center", color: "#71717a" }}>No data to display. Preview data: {preview ? "loaded" : "not loaded"}</div>}
        <table style={S.table}>
          <thead>
            <tr>{cols.map(c => <th key={c} style={S.th}>{c}</th>)}</tr>
          </thead>
          <tbody>
            {paged.map((row, i) => (
              <tr key={i}>
                {cols.map(c => <td key={c} style={S.td}>{String(row[c] ?? "").slice(0, 60)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "10px 14px", borderTop: "1px solid rgba(255,255,255,.05)", fontSize: 12, color: "#71717a" }}>
          <span>{filtered.length} rows{search ? ` (filtered from ${rows.length})` : ""}</span>
          <div style={{ display: "flex", gap: 8 }}>
            <button onClick={handlePrevPage} disabled={page === 0}
              style={{ ...S.btn, padding: "4px 10px", fontSize: 11, opacity: page === 0 ? 0.4 : 1, cursor: page === 0 ? "not-allowed" : "pointer" }}>← Prev</button>
            <span style={{ padding: "4px 8px" }}>{page + 1} / {totalPages || 1}</span>
            <button onClick={() => handleNextPage(totalPages)} disabled={page >= totalPages - 1}
              style={{ ...S.btn, padding: "4px 10px", fontSize: 11, opacity: page >= totalPages - 1 ? 0.4 : 1, cursor: page >= totalPages - 1 ? "not-allowed" : "pointer" }}>Next →</button>
          </div>
        </div>
      </div>
    </div>
  );
});

