// MAIN DASHBOARD - Lazy tab rendering
// ═══════════════════════════════════════════════════════════════════════════════
const TABS = ["📊 Overview", "🔍 Data Explorer", "📈 Charts", "🩺 Data Doctor"];

export default function Dashboard() {
  const [tab, setTab] = useState(0);

  // Cached dataset info
  const { data: dsInfo } = useApiCache(
    "dashboard-info",
    useCallback(async () => {
      const res = await api.get("/data/info");
      const d = res.data;
      if (d && typeof d.rows === "number") return d;
      return null;
    }, []),
    []
  );

  const handleTabChange = useCallback((i) => {
    startTransition(() => {
      setTab(i);
    });
  }, []);

  const handleClean = useCallback(() => {
    api.post("/data/clean").catch(() => {});
  }, []);

  const handleExport = useCallback(() => {
    api.get("/reports/export/csv").then(r => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([r.data]));
      a.download = "export.csv";
      a.click();
    }).catch(() => {});
  }, []);

  // Memoize dataset summary
  const datasetSummary = useMemo(() => {
    if (!dsInfo) return "Upload a dataset to get started";
    return `${dsInfo.rows?.toLocaleString()} rows · ${dsInfo.columns} columns`;
  }, [dsInfo]);

  return (
    <Safe>
      <div style={S.page}>
        <div style={S.header}>
          <div>
            <div style={S.title}>📊 Dashboard</div>
            <div style={S.sub}>{datasetSummary}</div>
          </div>
          {dsInfo && (
            <div style={{ display: "flex", gap: 8 }}>
              <button onClick={handleClean}
                style={{ ...S.btn, background: "rgba(16,185,129,.15)", color: "#34d399", border: "1px solid rgba(16,185,129,.3)" }}>
                🧹 Clean
              </button>
              <button onClick={handleExport}
                style={{ ...S.btn, background: "rgba(99,102,241,.15)", color: "#818cf8", border: "1px solid rgba(99,102,241,.3)" }}>
                ⬇ Export
              </button>
            </div>
          )}
        </div>

        <div style={S.tabs}>
          {TABS.map((t, i) => (
            <button key={t} onClick={() => handleTabChange(i)} style={S.tab(tab === i)}>{t}</button>
          ))}
        </div>

        {/* Lazy tab rendering - only render active tab */}
        <Safe>
          {tab === 0 && <OverviewTab />}
          {tab === 1 && <ExplorerTab />}
          {tab === 2 && <ChartsTab />}
          {tab === 3 && <DoctorTab />}
        </Safe>
      </div>
    </Safe>
  );
}
