// CHARTS TAB - Debounced chart building + searchable dropdown
// ═══════════════════════════════════════════════════════════════════════════════
const ChartsTab = memo(function ChartsTab() {
  const [xCol, setXCol] = useState("");
  const [yCol, setYCol] = useState("");
  const [chartType, setType] = useState("Bar");
  const [chart, setChart] = useState(null);
  const [loading, setLoad] = useState(false);
  const [error, setError] = useState("");
  const [buildTrigger, setBuildTrigger] = useState(0);

  // Debounce the build trigger
  const debouncedBuildTrigger = useDebounce(buildTrigger, 300);

  // Cached info data
  const { data: info } = useApiCache(
    "data-info-charts",
    useCallback(async () => {
      const res = await api.get("/data/info");
      return res.data;
    }, []),
    []
  );

  // Memoize chart types list
  const CHART_TYPES = useMemo(() => [
    // Classic
    "Bar", "Line", "Scatter", "Pie", "Histogram", "Box", "Heatmap", "Area",
    "Treemap", "Radar", "Waterfall", "Stacked Bar", "Stacked Area",
    "Bubble", "Violin", "Funnel", "Sunburst",
    "Marimekko", "Table with Charts", "3D Area",
    // 2026 Trending
    "Sankey", "Beeswarm", "Bullet", "Small Multiples",
    "Rose", "Time Series", "Infographic", "Network Graph", "Gantt",
    // Advanced / AI-Era
    "Parallel Coordinates", "Chord", "Hexbin", "Ridgeline", "Streamgraph",
    "Dendrogram", "Voronoi", "Uncertainty", "PCA", "SHAP", "Choropleth", "Event Stream",
    // Statistical
    "Q-Q Plot", "ECDF", "KDE", "Rug Plot", "Dot Plot", "Lollipop",
    "Slope Chart", "Dumbbell", "Diverging Bar",
    // Business & Financial
    "Candlestick", "Pair Plot", "Donut", "Waffle", "Pyramid", "100% Stacked",
    // Time-Series
    "ACF", "Contour", "Run Chart", "Control Chart",
    // Creative
    "Polar Line", "Radial Bar", "Circle Packing", "Arc Diagram", "Spiral", "Funnel Area",
    // ML & AI
    "ROC Curve", "Precision Recall", "Confusion Matrix", "Learning Curve", "Monte Carlo", "Drawdown",
    // Matrix & Correlation
    "Correlogram", "Cluster Heatmap", "Radial Heatmap", "Faceted Heatmap",
    // Hierarchical
    "Icicle", "Surface",
    // Text & Bonus
    "Word Frequency", "Horizon", "Animated Bubble",
    // Statistical Advanced
    "PDF Plot", "Kaplan-Meier", "Periodogram", "Adjacency Matrix", "Pareto", "Manhattan", "Volcano",
    // Finance & Ops
    "Dual Axis", "KPI Traffic Light", "Efficient Frontier", "Gain Chart",
    // Spatial & Signal
    "Delaunay", "Convex Hull", "Cross Correlation", "PACF", "Log Heatmap",
    // Composite
    "Variance Analysis", "Composite", "3D Volume",
    // Survival & Signal
    "Nelson-Aalen", "Hazard Function", "ACF Heatmap", "Scalogram", "Coherence",
    // Network & Security
    "Community Graph", "Attack Graph", "Animated Network", "Linked Brushing",
    // Business Intelligence
    "Sensitivity Analysis", "Strategy Map", "Balanced Scorecard",
    // Spatial & UX
    "Alpha Shape", "Faceted Grid", "User Journey",
    // Hybrid & Narrative
    "Sankey Heatmap", "Narrative", "Storyboard",
  ], []);

  // Memoize type map
  const TYPE_MAP = useMemo(() => ({
    "Stacked Bar": "stacked_bar",
    "Stacked Area": "stacked_area",
    "Table with Charts": "table_sparkline",
    "3D Area": "3d_area",
    "Marimekko": "marimekko",
    "Sankey": "sankey",
    "Beeswarm": "beeswarm",
    "Bullet": "bullet",
    "Small Multiples": "small multiples",
    "Rose": "rose",
    "Time Series": "timeseries",
    "Network Graph": "network",
    "Gantt": "gantt",
    "Parallel Coordinates": "parallel coordinates",
    "Chord": "chord",
    "Hexbin": "hexbin",
    "Ridgeline": "ridgeline",
    "Streamgraph": "streamgraph",
    "Dendrogram": "dendrogram",
    "Voronoi": "voronoi",
    "Uncertainty": "uncertainty",
    "PCA": "pca",
    "SHAP": "shap",
    "Choropleth": "choropleth",
    "Event Stream": "event stream",
    "Q-Q Plot": "qq plot",
    "ECDF": "ecdf",
    "KDE": "kde",
    "Rug Plot": "rug plot",
    "Dot Plot": "dot plot",
    "Lollipop": "lollipop",
    "Slope Chart": "slope chart",
    "Dumbbell": "dumbbell",
    "Diverging Bar": "diverging bar",
    "Candlestick": "candlestick",
    "Pair Plot": "pair plot",
    "Donut": "donut",
    "Waffle": "waffle",
    "Pyramid": "pyramid",
    "100% Stacked": "100% stacked",
    "ACF": "acf",
    "Contour": "contour",
    "Run Chart": "run chart",
    "Control Chart": "control chart",
    "Polar Line": "polar line",
    "Radial Bar": "radial bar",
    "Circle Packing": "circle packing",
    "Arc Diagram": "arc diagram",
    "Spiral": "spiral",
    "Funnel Area": "funnel area",
    "ROC Curve": "roc curve",
    "Precision Recall": "precision recall",
    "Confusion Matrix": "confusion matrix",
    "Learning Curve": "learning curve",
    "Monte Carlo": "monte carlo",
    "Drawdown": "drawdown",
    "Correlogram": "correlogram",
    "Cluster Heatmap": "cluster heatmap",
    "Radial Heatmap": "radial heatmap",
    "Faceted Heatmap": "faceted heatmap",
    "Icicle": "icicle",
    "Surface": "surface",
    "Word Frequency": "word frequency",
    "Horizon": "horizon",
    "Animated Bubble": "animated bubble",
    "PDF Plot": "pdf plot",
    "Kaplan-Meier": "kaplan meier",
    "Periodogram": "periodogram",
    "Adjacency Matrix": "adjacency matrix",
    "Pareto": "pareto frontier",
    "Manhattan": "manhattan plot",
    "Volcano": "volcano plot",
    "Dual Axis": "dual axis",
    "KPI Traffic Light": "kpi traffic light",
    "Efficient Frontier": "efficient frontier",
    "Gain Chart": "gain chart",
    "Delaunay": "delaunay",
    "Convex Hull": "convex hull",
    "Cross Correlation": "cross correlation",
    "PACF": "pacf",
    "Log Heatmap": "log heatmap",
    "Variance Analysis": "variance analysis",
    "Composite": "composite",
    "3D Volume": "3d scatter volume",
    "Nelson-Aalen": "nelson aalen",
    "Hazard Function": "hazard function",
    "ACF Heatmap": "autocorrelation heatmap",
    "Scalogram": "scalogram",
    "Coherence": "coherence",
    "Community Graph": "community graph",
    "Attack Graph": "attack graph",
    "Animated Network": "animated network",
    "Linked Brushing": "linked brushing",
    "Sensitivity Analysis": "sensitivity analysis",
    "Strategy Map": "strategy map",
    "Balanced Scorecard": "balanced scorecard",
    "Alpha Shape": "alpha shape",
    "Faceted Grid": "faceted grid",
    "User Journey": "user journey",
    "Sankey Heatmap": "sankey heatmap",
    "Narrative": "narrative",
    "Storyboard": "storyboard",
  }), []);

  // Initialize columns - skip ID columns and select meaningful ones
  useEffect(() => {
    if (info) {
      const cols = info.columns_info?.map(c => c.name) || [];
      
      // Filter out ID columns (Row ID, Order ID, etc.)
      const meaningfulCols = cols.filter(col => 
        !col.toLowerCase().includes('id') && 
        !col.toLowerCase().includes('index') &&
        !col.toLowerCase().includes('key')
      );
      
      // Use meaningful columns if available, otherwise use all columns
      const colsToUse = meaningfulCols.length >= 2 ? meaningfulCols : cols;
      
      if (colsToUse[0] && !xCol) setXCol(colsToUse[0]);
      if (colsToUse[1] && !yCol) setYCol(colsToUse[1]);
    }
  }, [info, xCol, yCol]);

  // Build chart when debounced trigger changes
  const buildChart = useCallback(async () => {
    if (!xCol) return;
    
    setLoad(true);
    setError("");
    
    try {
      const effectiveType = TYPE_MAP[chartType] || chartType;
      const effectiveY = yCol || xCol;
      
      const { data } = await api.post("/viz/custom", {
        chart_type: effectiveType,
        x_col: xCol,
        y_col: effectiveY,
      });
      
      setChart(data?.plotly_json || data);
    } catch(e) {
      const detail = e.response?.data?.detail || e.message || "Chart build failed";
      setError(detail);
    } finally {
      setLoad(false);
    }
  }, [xCol, yCol, chartType, TYPE_MAP]);

  // Trigger build on debounced value change
  useEffect(() => {
    if (debouncedBuildTrigger > 0) {
      buildChart();
    }
  }, [debouncedBuildTrigger, buildChart]);

  const handleBuildClick = useCallback(() => {
    setBuildTrigger(t => t + 1);
  }, []);

  const handleXChange = useCallback((e) => {
    setXCol(e.target.value);
  }, []);

  const handleYChange = useCallback((e) => {
    setYCol(e.target.value);
  }, []);

  const handleTypeChange = useCallback((value) => {
    setType(value);
  }, []);

  const cols = useMemo(() => info?.columns_info?.map(c => c.name) || [], [info]);

  // Memoize hint messages
  const hintMessage = useMemo(() => {
    const hints = {
      "Pie": { text: "💡 Pie: X = category, Y = numeric value", color: "#f59e0b" },
      "Waterfall": { text: "💡 Waterfall: X = labels, Y = numeric values", color: "#0ea5e9" },
      "Funnel": { text: "💡 Funnel: X = labels, Y = numeric values", color: "#0ea5e9" },
      "Radar": { text: "💡 Radar: uses all numeric columns automatically", color: "#10b981" },
      "Heatmap": { text: "💡 Heatmap: uses all numeric columns automatically", color: "#10b981" },
      "Marimekko": { text: "💡 Marimekko: X = category, Y = numeric — bar width = share of total", color: "#a855f7" },
      "Table with Charts": { text: "💡 Table with Charts: shows data table with sparklines — no column selection needed", color: "#06b6d4" },
      "3D Area": { text: "💡 3D Area: uses first 3 numeric columns as X, Y, Z axes automatically", color: "#f97316" },
      "Sankey": { text: "🔀 Sankey/Alluvial: X = source category, Y = target category — shows flow between groups", color: "#6366f1" },
      "Beeswarm": { text: "🐝 Beeswarm: X = category (optional), Y = numeric — shows every data point without overlap", color: "#10b981" },
      "Bullet": { text: "🎯 Bullet Chart: compact KPI view — actual vs target vs performance range for all numeric columns", color: "#f59e0b" },
      "Small Multiples": { text: "🔲 Small Multiples: X = category (facet), Y = numeric — side-by-side comparison grid", color: "#8b5cf6" },
      "Rose": { text: "🌹 Rose/Polar Area: X = category — visually appealing alternative to pie charts", color: "#ec4899" },
      "Time Series": { text: "📈 Time Series: X = time/index column — multi-layered with range slider for large datasets", color: "#0ea5e9" },
      "Infographic": { text: "📰 Infographic: storytelling summary — KPI cards with delta indicators for all numeric columns", color: "#a855f7" },
      "Network Graph": { text: "🕸 Network Graph: X = source node, Y = target node (category columns) — node size = connection count. Falls back to correlation network if no category columns.", color: "#6366f1" },
      "Gantt": { text: "📅 Gantt: X = task/name column, Y = duration/numeric — auto-detects start/end columns if present (e.g. \"start_date\", \"end_date\")", color: "#10b981" },
    };
    return hints[chartType];
  }, [chartType]);

  if (!info) return <div style={S.empty}>No dataset loaded</div>;

  return (
    <div>
      <div style={{ ...S.card, display: "flex", gap: 12, flexWrap: "wrap", alignItems: "flex-end" }}>
        <div style={{ flex: "1 1 160px" }}>
          <div style={{ fontSize: 11, color: "#71717a", marginBottom: 4 }}>Chart Type (Searchable)</div>
          <SearchableSelect
            value={chartType}
            onChange={handleTypeChange}
            options={CHART_TYPES}
            placeholder="Select chart type..."
          />
        </div>
        <div style={{ flex: "1 1 140px" }}>
          <div style={{ fontSize: 11, color: "#71717a", marginBottom: 4 }}>X Column</div>
          <select style={S.select} value={xCol} onChange={handleXChange}>
            {cols.map(c => <option key={c}>{c}</option>)}
          </select>
        </div>
        <div style={{ flex: "1 1 140px" }}>
          <div style={{ fontSize: 11, color: "#71717a", marginBottom: 4 }}>Y Column</div>
          <select style={S.select} value={yCol} onChange={handleYChange}>
            <option value="">— same as X —</option>
            {cols.map(c => <option key={c}>{c}</option>)}
          </select>
        </div>
        <button onClick={handleBuildClick} disabled={loading || !xCol} style={{
          ...S.btn,
          cursor: (loading || !xCol) ? "not-allowed" : "pointer",
          opacity: (loading || !xCol) ? 0.6 : 1
        }}>
          {loading ? "Building…" : "📊 Build Chart"}
        </button>
      </div>

      {error && <div style={{ color: "#f87171", fontSize: 13, marginBottom: 12, padding: "8px 12px", background: "rgba(239,68,68,.05)", borderRadius: 8 }}>{error}</div>}
      
      {hintMessage && (
        <div style={{ fontSize: 12, color: hintMessage.color, marginBottom: 12, padding: "6px 12px", background: `${hintMessage.color}10`, borderRadius: 8 }}>
          {hintMessage.text}
        </div>
      )}

      {loading && (
        <div style={S.chartCard}>
          <div style={S.chartTitle}>Building chart...</div>
          <SkeletonChart height={420} />
        </div>
      )}

      {!loading && chart && (
        <div style={S.chartCard}>
          <Safe><Chart figure={chart} height={420} /></Safe>
        </div>
      )}
    </div>
  );
});

